# Server & App URL
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# MongoDB Connection (falls back to in-memory store if offline)
MONGODB_URI=mongodb://127.0.0.1:27017/teams_cleanroom

# LiveKit WebRTC SFU Credentials
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
